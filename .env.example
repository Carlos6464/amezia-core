# Postgres (docker-compose)
POSTGRES_USER=amezia
POSTGRES_PASSWORD=amezia
POSTGRES_DB=amezia

# Portas do host pro nginx (entry point único). Em dev, padrão 8080/8443 pra
# não colidir com um Apache/Nginx do sistema já ocupando 80/443. Em produção
# (VPS com domínio próprio), setar NGINX_PORT=80 e NGINX_HTTPS_PORT=443.
NGINX_PORT=8080
NGINX_HTTPS_PORT=8443

# Ambiente (development | production) — controla, entre outras coisas, se o
# cookie de refresh do auth (build-context-01) exige HTTPS (Secure). Em
# produção com domínio + certificado, sempre "production".
ENVIRONMENT=development

# API (apps/api/src/infrastructure/config.py)
DATABASE_URL=postgresql+asyncpg://amezia:amezia@postgres:5432/amezia
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Base usada para montar o link no email de reset de senha (build-context-01)
# Em produção: https://amezia.com.br
FRONTEND_URL=http://localhost:8080

# Providers de IA (build-context-04)
GEMINI_API_KEY=
GROK_API_KEY=

# WhatsApp / Evolution API (build-context-07)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# Email transacional (build-context-01)
RESEND_API_KEY=

# Login social (build-context-01)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Criptografia de campos sensíveis (RN-05) — chave Fernet (AES128-CBC+HMAC),
# gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AES_ENCRYPTION_KEY=

# Hash determinístico de telefone (build-context-07 §2.2) — HMAC-SHA256,
# índice paralelo a users.phone/whatsapp_sessions.phone_hash, chave dedicada
# (nunca AES_ENCRYPTION_KEY). Gerar com:
# python -c "import secrets; print(secrets.token_hex(32))"
PHONE_HASH_SECRET=

# Armazenamento de comprovante de transação (build-context-03) — bucket
# privado, API S3-compatível do Backblaze B2 (endpoint varia por região,
# ex.: https://s3.us-west-002.backblazeb2.com)
BACKBLAZE_KEY_ID=
BACKBLAZE_APPLICATION_KEY=
BACKBLAZE_BUCKET_NAME=
BACKBLAZE_ENDPOINT_URL=
BACKBLAZE_REGION=
